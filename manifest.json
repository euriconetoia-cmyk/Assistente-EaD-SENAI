{
  "manifest_version": 3,
  "name": "Assistente EaD SENAI",
  "version": "3.7.0",
  "description": "Painel de tutoria Moodle para acompanhar alunos, atividades, notas, pendências e fechamento de UCs.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://ead.senai.br/*",
    "https://ead.fieg.com.br/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "Abrir Assistente EaD SENAI"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ead.senai.br/*",
        "https://ead.fieg.com.br/*"
      ],
      "css": [
        "content/page-layout.css"
      ],
      "js": [
        "content/namespace.js",
        "content/shared-validation.js",
        "content/utils.js",
        "content/language.js",
        "content/storage.js",
        "content/adapters.js",
        "content/collectors.js",
        "content/rules.js",
        "content/exporters.js",
        "content/assisted-grading.js",
        "content/batch-grading.js",
        "content/communications.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://ead.fieg.com.br/mod/assign/view.php*",
        "https://ead.fieg.com.br/course/view.php*",
        "https://ead.fieg.com.br/course/index.php*",
        "https://ead.fieg.com.br/my/*",
        "https://ead.senai.br/mod/assign/view.php*",
        "https://ead.senai.br/course/view.php*",
        "https://ead.senai.br/course/index.php*",
        "https://ead.senai.br/my/*"
      ],
      "css": [
        "content/importer/contextual-importer.css"
      ],
      "js": [
        "content/shared-validation.js",
        "content/importer/contextual-importer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/styles.css", "assets/icon32.png", "dashboard/index.html", "dashboard/dashboard.css", "dashboard/directory-access.js", "dashboard/audit-export.js", "dashboard/dashboard.js"],
      "matches": ["https://ead.senai.br/*", "https://ead.fieg.com.br/*"]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
